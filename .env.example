# MetaTrader 5 Terminal Configuration (Optional: MT5 uses active terminal if omitted)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=Exness-MT5Real
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Broker & Instrument Settings
SYMBOL=XAUUSDm
REFERENCE_BALANCE=50.00
TARGET_RISK_USD=2.00
MAX_SL_POINTS=200
MAX_SPREAD_POINTS=35

# Strict Safety Latches
DRY_RUN_ENABLED=True
OPERATING_MODE=PAPER_TRADING

# Telegram Bot Notifications (100% Free via @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
